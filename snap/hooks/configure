#!/bin/bash
set -e

# =====================================================================
# 1. SNAP CONFIGURATION DATABASE INITIALIZATION
# =====================================================================

if [ -z "$(snapctl get backend.url)" ]; then
    snapctl set backend.url="http://127.0.0.1:13305"
fi

if [ -z "$(snapctl get backend.maxsteps)" ]; then
    snapctl set backend.maxsteps=50
fi

for provider in openai anthropic groq tavily serper; do
    if [ -z "$(snapctl get "keys.${provider}")" ]; then
        snapctl set "keys.${provider}"=""
    fi
done

# =====================================================================
# 2. APPLICATION WORKSPACE COMPILATION ENGINE
# =====================================================================

URL=$(snapctl get backend.url)
STEPS=$(snapctl get backend.maxsteps)

CLEAN_URL=$(echo "$URL" | sed 's:/*$::')

if [[ "$CLEAN_URL" == */api/v1* ]]; then
    BASE_URL="$CLEAN_URL"
else
    BASE_URL="${CLEAN_URL}/api/v1"
fi

# Write to SNAP_COMMON so all users on the host can access the snap configuration
# instead of writing to /root/.gaia
TARGET_DIR="$SNAP_COMMON/etc/gaia"
mkdir -p "$TARGET_DIR"

cat << EOF > "$TARGET_DIR/config.json"
{
  "llm_url": "${CLEAN_URL}",
  "backend": {
    "url": "${BASE_URL}",
    "max_steps": ${STEPS}
  },
  "profile": "minimal"
}
EOF

echo "LOG: Global snap configuration compiled to $TARGET_DIR/config.json"